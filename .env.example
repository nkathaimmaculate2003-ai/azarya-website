# Copy this file to .env.local for local development, and add the same
# variables in your hosting provider's settings (e.g. Vercel > Project >
# Settings > Environment Variables) for production.
# NEVER commit real values. .env.local is ignored by Git.

# Public website address, without a trailing slash. Used for canonical URLs,
# the sitemap, Open Graph tags and structured data.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.example

# --- Contact form email delivery (Resend: https://resend.com) ---
# Server-side only. These are never sent to the browser.
RESEND_API_KEY=
# Where enquiries are delivered. Separate multiple addresses with commas.
CONTACT_TO_EMAIL=
# Sender address on a domain verified in Resend, e.g. "Azarya Website <website@your-domain.example>"
CONTACT_FROM_EMAIL=

# Local development only: set to "true" to print form submissions to the
# terminal instead of emailing them. Ignored in production.
CONTACT_DEV_LOG_ONLY=false
